#!/usr/bin/env bash
# Hook pre-push de Luma-Lab. Se activa con: bash scripts/instalar-hooks.sh
#
#   main         nunca se pushea directo: entra solo por PR desde development.
#   development  push directo solo si TODO lo que cambia es documentación
#                (*.md o docs/**). El código entra por PR desde una rama propia.
#
# Guía completa y solución a cada mensaje:
#   https://github.com/luma-lab-io/comunidad/blob/main/docs/sitio/flujo-de-ramas.md
#   otras ramas  libre.

set -euo pipefail

ZERO=0000000000000000000000000000000000000000
DOC_REGEX='(\.md$|^docs/)'
fallo=0

while read -r local_ref local_sha remote_ref remote_sha; do
  rama="${remote_ref#refs/heads/}"

  case "$rama" in
    main)
      echo "pre-push: no se pushea directo a main. Abre un PR desde development." >&2
      fallo=1
      ;;
    development)
      if [ "$local_sha" = "$ZERO" ]; then
        echo "pre-push: no se borra development." >&2
        fallo=1
        continue
      fi
      if [ "$remote_sha" = "$ZERO" ]; then
        base=$(git merge-base "$local_sha" origin/main 2>/dev/null || true)
      else
        base="$remote_sha"
      fi
      if [ -z "$base" ]; then
        echo "pre-push: no pude calcular qué cambia (haz git fetch y reintenta)." >&2
        fallo=1
        continue
      fi
      codigo=$(git diff --name-only "$base" "$local_sha" | grep -v -E "$DOC_REGEX" || true)
      if [ -n "$codigo" ]; then
        echo "pre-push: development solo acepta push directo de documentación." >&2
        echo "Estos archivos no son doc-only:" >&2
        echo "$codigo" | sed 's/^/  - /' >&2
        echo "Sube tu rama (ej. feature/<nombre>-<tema>) y abre un PR a development." >&2
        fallo=1
      fi
      ;;
  esac
done

if [ "$fallo" -ne 0 ]; then
  echo "" >&2
  echo "Qué hacer con cada error: https://github.com/luma-lab-io/comunidad/blob/main/docs/sitio/flujo-de-ramas.md#errores-y-qué-hacer" >&2
fi

exit "$fallo"
